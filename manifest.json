{
  "manifest_version": 3,
  "name": "Simulise Docent",
  "version": "0.27.0",
  "description": "Thema's en docent-tools voor Simulise (ma.simulise.com). Draait lokaal; controleert alleen GitHub op updates.",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*.sharepoint.com/*",
    "https://1drv.ms/*",
    "https://onedrive.live.com/*",
    "https://api.onedrive.com/*",
    "https://*.1drv.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Simulise Docent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "update/update.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.simulise.com/*"
      ],
      "css": [
        "theme.css"
      ],
      "js": [
        "modules/registry.js",
        "modules/core.js",
        "modules/regels.js",
        "modules/klassen.js",
        "modules/perioden.js",
        "modules/thema.js",
        "modules/beoordelen.js",
        "modules/meldingen.js",
        "modules/vandaag.js",
        "modules/schil.js",
        "modules/focus.js",
        "modules/media.js",
        "modules/matrix.js",
        "modules/inzicht.js",
        "modules/opdracht.js",
        "rapport/standaard.js",
        "rapport/xlsx.js",
        "rapport/bron.js",
        "rapport/render.js",
        "rapport/weergave.js",
        "modules/rapporten.js",
        "modules/zoeken.js",
        "modules/zijbalk.js",
        "modules/inspector.js",
        "modules/hulpknop.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.simulise.com/*"
      ],
      "js": [
        "modules/netlog.js",
        "modules/perpagina.js",
        "modules/teller.js",
        "modules/gql.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
